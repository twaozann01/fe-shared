# Scope @twaozann01 lấy từ GitHub Packages, không phải npmjs.
# (GitHub Packages bắt buộc scope trùng tên chủ repo — chủ là twaozann01.)
@twaozann01:registry=https://npm.pkg.github.com

# CỐ Ý không khai dòng _authToken ở đây:
#  - Trong repo này mọi package @twaozann01/* đều là workspace, không cần token để cài.
#  - Trên CI, actions/setup-node tự sinh .npmrc kèm token từ NODE_AUTH_TOKEN.
#  - Ở máy cá nhân muốn cài package đã publish thì chạy: gh auth token | npm config set ...
#    hoặc thêm dòng token vào ~/.npmrc (file NGOÀI repo, không bao giờ commit).

shamefully-hoist=false
strict-peer-dependencies=false
