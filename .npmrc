# pnpm dựng node_modules phẳng vừa đủ để Storybook (Vite) resolve được peer dependency.
shamefully-hoist=false
strict-peer-dependencies=false

# Khi publish lên GitHub Packages, bỏ comment hai dòng dưới và đổi scope cho khớp
# tên chủ repo trên GitHub (GitHub Packages BẮT BUỘC scope trùng tên owner):
# @twaozann:registry=https://npm.pkg.github.com
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
