    "react-leaflet": "^4.2.0"
  },
  "devDependencies": {
    "@twaozann01/eslint-config": "workspace:*",
    "@twaozann01/typescript-config": "workspace:*",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twaozann01/fe-shared.git",
